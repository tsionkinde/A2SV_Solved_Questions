class Solution:
    def splitString(self, s: str) -> bool:
        def backtrack(index,prev,count):
            if index==len(s):
                return count>=2
            num=0
            for i in range(index,len(s)):
                num=num*10 +int (s[i])
                if prev is None:
                    if backtrack(i+1,num,count+1):
                        return True
                else:
                    if num==prev-1:
                        if backtrack(i+1,num,count+1):
                            return True
                    elif num>=prev:
                        break
            return False
        return backtrack(0,None,0)                            




        
